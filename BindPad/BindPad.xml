                            GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
                            GameTooltip:SetText(BindPadL.TOOLTIP_CREATE_MACRO)
                        end
                    </OnEnter>
                    <OnLeave>
                        self.Plus:SetAlpha(0.35)
