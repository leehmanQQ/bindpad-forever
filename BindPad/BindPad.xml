                    <Anchor point="BOTTOMRIGHT" x="-5" y="4" />
                </Anchors>
                <Scripts>
                    <OnClick>
                        HideUIPanel(self:GetParent())
                    </OnClick>
                </Scripts>
            </Button>
            <Button name="BindPadMacroFrameTestButton" inherits="UIPanelButtonTemplate, SecureActionButtonTemplate">
                <Size x="80" y="22" />
                <Anchors>
                    <Anchor point="RIGHT" relativeTo="BindPadMacroFrameExitButton" relativePoint="LEFT" x="-2" y="0" />
                </Anchors>
                <Scripts>
                    <OnLoad inherit="prepend">
                        self:SetText(BindPadL.TEXT_TEST)
                        self:SetAttribute("type", "macro")
                    </OnLoad>
                    <OnMouseDown inherit="prepend">
                        if not InCombatLockdown() then
                            self:SetAttribute("macrotext", BindPadMacroFrameText:GetText())
                        end
                    </OnMouseDown>
                </Scripts>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad>
                self:SetTitle(BindPadL.MACRO_TITLE)
                self:SetPortraitToAsset("Interface\\MacroFrame\\MacroFrame-Icon")
            </OnLoad>
            <OnShow>
                PlaySound(SOUNDKIT.IG_CHARACTER_INFO_OPEN)
                BindPadMacroFrame_OnShow(self)
            </OnShow>
            <OnHide>
                PlaySound(SOUNDKIT.IG_CHARACTER_INFO_CLOSE)
                BindPadMacroFrame_OnHide(self)
            </OnHide>
            <OnMouseWheel>
                return
            </OnMouseWheel>
        </Scripts>
