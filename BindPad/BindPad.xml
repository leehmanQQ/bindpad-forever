                    <MaskedTextures>
                        <MaskedTexture childKey="icon" />
                    </MaskedTextures>
                </MaskTexture>
            </Layer>
        </Layers>
        <NormalTexture atlas="UI-HUD-ActionBar-IconFrame">
            <Anchors>
                <Anchor point="TOPLEFT" />
                <Anchor point="BOTTOMRIGHT" x="1" y="0" />
            </Anchors>
