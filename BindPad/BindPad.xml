                            <Size x="16" y="16" />
                            <Anchors>
                                <Anchor point="CENTER" />
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnLoad>
                        self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
